DJANGO_SETTINGS_MODULE=config.settings.dev

# URL of the Django backend reachable from the Next.js build context.
# Docker: set via compose.yaml build args (http://backend:8000 / http://backend_prod:8000)
# Local dev (no Docker): create frontend/.env.local with BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000